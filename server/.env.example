# Salin ke server/.env lalu isi. File .env tidak boleh di-commit.

# Neon > Connect > "Connection pooling" ON (host mengandung -pooler). Dipakai API.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Neon > Connect > "Connection pooling" OFF. Dipakai migration dan seed.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=4000

# Hanya untuk mencari foto saat pengembangan. Tidak dibutuhkan saat deploy.
UNSPLASH_ACCESS_KEY=
